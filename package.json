{
  "name": "certia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @certia/web build && pnpm --filter @certia/api build && pnpm --filter @certia/worker build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm typecheck",
    "db:generate": "pnpm --filter @certia/db generate",
    "db:migrate": "pnpm --filter @certia/db migrate",
    "db:seed": "pnpm --filter @certia/db seed",
    "measures:check": "pnpm --filter @certia/measures check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
