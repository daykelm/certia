# --- Base de datos ---
DATABASE_URL=postgres://certia:certia@localhost:5432/certia

# --- Aplicación ---
# api | worker (la misma imagen arranca en ambos modos)
APP_MODE=api
PORT=3000
LOG_LEVEL=info

# --- Autenticación (F-01, pendiente) ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=example.com
# Solo desarrollo: usuario con el que se identifican las peticiones mientras no hay login
DEV_USER_EMAIL=admin@example.com

# --- Almacenamiento de documentos ---
# local | gcs
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=

# --- Cola de tareas ---
# postgres | cloudtasks
QUEUE_DRIVER=postgres

# --- PDF ---
GOTENBERG_URL=http://localhost:3001

# --- IA de extracción ---
# none | vertex
AI_PROVIDER=none
AI_MODEL=

# --- Cifrado de datos sensibles (F-16) ---
# Local: clave de 32 bytes en base64 (genera una con: openssl rand -base64 32)
# Producción: referencia a una clave de Cloud KMS
ENCRYPTION_KEY=
ENCRYPTION_KEY_REF=
