# --- Database ---
DATABASE_URL=postgres://certia:certia@localhost:5432/certia

# --- Application ---
# api | worker | migrate (the same image runs in every mode)
APP_MODE=api
PORT=3000
LOG_LEVEL=info

# --- Authentication (F-01, pending) ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=example.com
# Development only: user every request is identified as until login exists
DEV_USER_EMAIL=admin@example.com

# --- Document storage ---
# local | gcs
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=

# --- Job queue ---
# postgres | cloudtasks
QUEUE_DRIVER=postgres

# --- PDF ---
GOTENBERG_URL=http://localhost:3001

# --- AI extraction ---
# none | vertex
AI_PROVIDER=none
AI_MODEL=

# --- Sensitive data encryption (F-16) ---
# Local: 32-byte key, base64 (generate one with: openssl rand -base64 32)
# Production: reference to a Cloud KMS key
ENCRYPTION_KEY=
ENCRYPTION_KEY_REF=
